# Server Configuration
NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:5003

# Database Configuration
# Use your MongoDB connection string here.
# For MongoDB Atlas, generate this from your cluster dashboard.
# For local development, use mongodb://127.0.0.1:27017/agroconnect
MONGODB_URI=mongodb://127.0.0.1:27017/agroconnect

# JWT Configuration
# JWT_SECRET should be a long random string for signing auth tokens.
JWT_SECRET=abcdefgh
JWT_EXPIRE=7d

# Stripe Payment Gateway
# Get these from your Stripe dashboard: https://dashboard.stripe.com
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email Configuration (Nodemailer)
# Use SMTP credentials for your email provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password_or_app_password
SMTP_FROM=noreply@agroconnect.com

# Cloudinary (Image Upload)
# Get these from your Cloudinary account settings.
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Maps API
# Generate this from Google Cloud Console if you use map or geocoding features.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Twilio (SMS/Voice - Optional)
# Get these from Twilio console if using SMS or phone notifications.
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# AI Pricing API (Optional)
# Only use if you integrate with an external pricing prediction service.
AI_PRICING_API_URL=https://api.example.com/pricing
AI_PRICING_API_KEY=your_ai_pricing_api_key

# Redis Configuration (for caching - optional)
REDIS_URL=redis://localhost:50016379

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
