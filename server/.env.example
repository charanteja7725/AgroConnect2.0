# Server Configuration
NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:5003

# Database Configuration
# Use your MongoDB connection string here.
# For MongoDB Atlas, generate this from your cluster dashboard.
# For local development, use mongodb://127.0.0.1:27017/agroconnect
MONGODB_URI=mongodb://127.0.0.1:27017/agroconnect

# JWT Configuration
# JWT_SECRET should be a long random string for signing auth tokens.
JWT_SECRET=abcdefgh
JWT_EXPIRE=7d

# JWT Reset Secret (CRITICAL - DO NOT USE SAME AS JWT_SECRET)
# This is a separate secret used ONLY for password reset tokens.
# This prevents a compromised reset token from being used as a login token.
# Generate a different strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_RESET_SECRET=agroconnect_password_reset_secret_with_minimum_64_characters_length_xyz456

# Stripe Payment Gateway (REQUIRED for payments)
# Get these from your Stripe dashboard: https://dashboard.stripe.com/apikeys
# TEST KEYS for development (pk_test_*, sk_test_*)
# LIVE KEYS for production (pk_live_*, sk_live_*)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Razorpay Payment Gateway (optional if using Razorpay instead of Stripe)
# Get these from your Razorpay dashboard: https://dashboard.razorpay.com/
# TEST KEYS for development (rzp_test_*)
RAZORPAY_KEY_ID=rzp_test_SnzLlXR5jl2GiG
RAZORPAY_KEY_SECRET=JAVnc07mifZDnJ4dsx4jTevw

# Email Configuration (Nodemailer) - For password reset emails
# Gmail Setup: https://myaccount.google.com/apppasswords (generate app password)
# Or use any SMTP provider (SendGrid, Mailgun, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=noreply@agroconnect.com

# Cloudinary (Image Upload) - For product images
# Get these from your Cloudinary account: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=dncs1n7pc
CLOUDINARY_API_KEY=744749928589928
CLOUDINARY_API_SECRET=EocrvZVXWW-PB-fI8W_uqAuvgIo

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Optional: Google Maps API - For geolocation features
# Generate at: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Optional: Twilio - For SMS notifications
# Get from https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Optional: External AI Pricing API
# Only needed if integrating real market price predictions
AI_PRICING_API_URL=https://api.example.com/pricing
AI_PRICING_API_KEY=your_ai_pricing_api_key

# IMPORTANT SECURITY NOTES:
# 1. NEVER commit .env file to version control - it's in .gitignore for a reason
# 2. Rotate secrets regularly in production
# 3. Use environment-specific values (dev keys for development, live keys for production)
# 4. Keep STRIPE_WEBHOOK_SECRET and JWT_RESET_SECRET confidential
# 5. All keys in production should be at least 64 characters and randomly generated

# Redis Configuration (for caching - optional)
REDIS_URL=redis://localhost:50016379

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
