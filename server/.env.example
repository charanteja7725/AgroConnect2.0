# Server configuration
NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:5003

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/agroconnect

# JWT
# Production startup requires JWT_SECRET to be at least 64 characters.
JWT_SECRET=replace_with_random_secret_at_least_64_characters_long_xxxxxxxxxxxxxxxxx
JWT_EXPIRE=7d
# Use a different random value from JWT_SECRET.
JWT_RESET_SECRET=replace_with_different_random_secret_at_least_64_characters_long_xxxxxx

# Razorpay (optional until Razorpay payments are enabled)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Stripe webhook support (optional until Stripe webhook flow is enabled)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email / Nodemailer (optional until email delivery is enabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@agroconnect.example

# Cloudinary
# Required in production for product uploads and farmer verification evidence.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Authentication rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Optional / reserved integrations
GOOGLE_MAPS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
AI_PRICING_API_URL=
AI_PRICING_API_KEY=
REDIS_URL=

# Security notes
# - Never commit server/.env.
# - Never place backend secrets in VITE_* variables.
# - Use separate development, test and production credentials.
# - Rotate any credential that was ever committed to Git history.
